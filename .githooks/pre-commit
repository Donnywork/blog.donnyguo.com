#!/bin/sh
set -eu

repository=$(git rev-parse --show-toplevel)
cd "$repository"
git diff --cached --check

# Check only staged content so an unstaged thumbnail cannot hide a missing asset.
snapshot=$(mktemp -d)
trap 'rm -rf "$snapshot"' EXIT
git checkout-index --all --prefix="$snapshot/"
(cd "$snapshot" && python3 "$repository/bin/check-content.py")

make check
